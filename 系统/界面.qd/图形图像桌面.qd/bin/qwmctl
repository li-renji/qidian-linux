#!/usr/bin/env python3
# -*- coding: utf-8 -*-
# ============================================================
# qwmctl —— 奇点OS 窗口管理器命令行客户端（对标 berry 的 berryc）
# 用法：
#   qwmctl move +20 -10        当前窗口相对移动
#   qwmctl move_absolute 100 80
#   qwmctl resize +40 +0 / resize_absolute 800 600
#   qwmctl center | maximize | monocle | fullscreen | decor
#   qwmctl snap_left | snap_right | close | minimize | raise
#   qwmctl cycle                循环切换焦点
#   qwmctl focus left|right|up|down
#   qwmctl ws 2                 切到工作区 2（0-3）
#   qwmctl send 3               把当前窗口送到工作区 3
#   qwmctl list                 列出所有窗口（JSON）
#   qwmctl title <id> <cmd>     对指定窗口发命令（id 见 list）
# ============================================================
import json
import sys
import os
import time
import socket

SOCK = '/tmp/qd_qwm.sock'
LIST_FILE = '/tmp/qd_qwm_list.json'

MAP = {
    'move': 'window_move', 'move_absolute': 'window_move_absolute',
    'resize': 'window_resize', 'resize_absolute': 'window_resize_absolute',
    'center': 'window_center', 'maximize': 'window_monocle',
    'monocle': 'window_monocle', 'fullscreen': 'fullscreen',
    'snap_left': 'snap_left', 'snap_right': 'snap_right',
    'close': 'window_close', 'raise': 'window_raise',
    'decor': 'toggle_decorations', 'cycle': 'cycle_focus',
    'ws': 'switch_workspace', 'send': 'send_to_workspace',
    'list': 'list', 'ping': 'ping', 'redecorate': 'redecorate',
    'unhide': 'window_unhide',
}


def send(payload):
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(2)
        s.connect(SOCK)
        s.sendall(json.dumps(payload).encode())
        try:
            s.recv(256)
        except Exception:
            pass
        s.close()
        return True
    except Exception as e:
        sys.stderr.write('qwmctl: 无法连接 qwm (%s)\n' % e)
        return False


def main():
    args = sys.argv[1:]
    if not args:
        print(__doc__ or 'see source header')
        return 0
    cmd = args[0]
    if cmd == 'focus':
        if len(args) < 2:
            sys.stderr.write('qwmctl focus left|right|up|down\n')
            return 2
        # 方向聚焦没有独立命令，等价于在 KEYMAP 里 Alt+Shift+方向；
        # 这里用 list 自行算出目标窗口再 raise
        send({'cmd': 'list'})
        time.sleep(0.15)
        try:
            data = json.load(open(LIST_FILE))
        except Exception:
            return 1
        cls = [c for c in data.get('clients', []) if c.get('visible')]
        cur = next((c for c in cls if c.get('focused')), None)
        if not cur:
            return 1
        d = args[1]
        cx, cy = cur['x'] + cur['w'] / 2, cur['y'] + cur['h'] / 2
        best, bd = None, None
        for c in cls:
            if c is cur:
                continue
            ox, oy = c['x'] + c['w'] / 2, c['y'] + c['h'] / 2
            dx, dy = ox - cx, oy - cy
            ok = ((d == 'left' and dx < -10) or (d == 'right' and dx > 10) or
                  (d == 'up' and dy < -10) or (d == 'down' and dy > 10))
            if not ok:
                continue
            dist = abs(dx) + abs(dy)
            if bd is None or dist < bd:
                bd, best = dist, c
        if best:
            send({'cmd': 'window_raise', 'id': best['id']})
        return 0

    action = MAP.get(cmd)
    if not action:
        sys.stderr.write('qwmctl: 未知命令 %s\n' % cmd)
        return 2
    payload = {'cmd': action}
    num = []
    for a in args[1:]:
        try:
            num.append(int(a))
        except Exception:
            pass
    if cmd in ('move', 'move_absolute', 'resize', 'resize_absolute'):
        payload['x'] = num[0] if len(num) > 0 else 0
        payload['y'] = num[1] if len(num) > 1 else 0
        if cmd.startswith('resize'):
            payload['w'], payload['h'] = payload.pop('x'), payload.pop('y')
    elif cmd in ('ws', 'send'):
        payload['i'] = num[0] if num else 0
    elif num:
        # G.21：unhide 等命令按窗口 ID 操作（灵动岛圆球还原通道）
        payload['id'] = num[0]
    ok = send(payload)
    if cmd == 'list':
        time.sleep(0.2)
        try:
            print(json.dumps(json.load(open(LIST_FILE)),
                             ensure_ascii=False, indent=1))
        except Exception:
            pass
    return 0 if ok else 1


if __name__ == '__main__':
    sys.exit(main())
