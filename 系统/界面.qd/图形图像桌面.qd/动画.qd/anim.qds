#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""动画.qd/anim.qds —— 过渡动画引擎 v2
提供：fade_in / fade_out / ball_appear（弹性缩放）/ slide_up
基于 GTK alpha + 尺寸动画（软渲染下够用）
"""
import gi
gi.require_version('Gtk', '3.0')
gi.require_version('Gdk', '3.0')
from gi.repository import Gtk, Gdk, GLib

def fade_in(win, duration_ms=200):
    """窗口淡入"""
    win.set_opacity(0.0)
    steps = 12
    delta = 1.0 / steps
    def step(current=[0]):
        current[0] += delta
        win.set_opacity(min(1.0, current[0]))
        if current[0] < 1.0:
            GLib.timeout_add(max(8, duration_ms // steps), step)
    step()

def fade_out(win, duration_ms=200, on_done=None):
    """窗口淡出"""
    steps = 12
    delta = 1.0 / steps
    def step(current=[1.0]):
        current[0] -= delta
        if current[0] > 0:
            win.set_opacity(max(0.0, current[0]))
            GLib.timeout_add(max(8, duration_ms // steps), step)
        else:
            win.set_opacity(0.0)
            if on_done:
                on_done()
    step()

def ball_appear(ball_win, duration_ms=300):
    """圆球出现：弹性缩放（overshoot 回弹）"""
    ball_win.set_opacity(0.0)
    ball_win.set_size_request(8, 8)
    # 关键帧：0%→30%→70%→100%  尺寸 8→54→38→42（弹性）
    frames = [
        (0.00, 8), (0.15, 18), (0.30, 54), (0.55, 46),
        (0.70, 38), (0.85, 44), (1.00, 42),
    ]
    steps = 20
    target = 42
    def step(current=[0]):
        current[0] += 1
        p = current[0] / steps
        op = min(1.0, p * 1.6)
        ball_win.set_opacity(op)
        # 插值关键帧
        size = frames[-1][1]
        for i in range(len(frames) - 1):
            t0, s0 = frames[i]
            t1, s1 = frames[i + 1]
            if t0 <= p <= t1:
                ratio = (p - t0) / (t1 - t0)
                size = int(s0 + (s1 - s0) * ratio)
                break
        ball_win.set_size_request(size, size)
        if current[0] < steps:
            GLib.timeout_add(max(10, duration_ms // steps), step)
        else:
            ball_win.set_size_request(target, target)
    step()

def slide_up(win, duration_ms=250):
    """抽屉上滑入场：从底部 40px 升到原位"""
    win.move(0, 800)
    win.set_opacity(0.0)
    steps = 14
    def step(current=[0]):
        current[0] += 1
        p = current[0] / steps
        # 缓出
        ease = 1 - (1 - p) ** 2
        win.move(0, int(800 * (1 - ease)))
        win.set_opacity(min(1.0, ease * 1.3))
        if current[0] < steps:
            GLib.timeout_add(max(10, duration_ms // steps), step)
        else:
            win.move(0, 0)
    step()

if __name__ == '__main__':
    print('动画引擎 v2：fade_in / fade_out / ball_appear / slide_up')
