{
  "name": "图形图像桌面",
  "id": "qd-ui-desktop",
  "version": "0.2.0",
  "type": "desktop",
  "author": "奇点OS",
  "description": "超级桌面应用（灵动岛/Dock/抽屉/圆球）；标准接口 start/stop/status/theme（规范附录B.2）",
  "entry": "bin/desktop.qds",
  "permissions": [
    "display",
    "input"
  ],
  "services": [
    "qd.ui.desktop"
  ],
  "depends": [
    "窗口.qd",
    "动画.qd"
  ],
  "interface": {
    "start": "bin/desktop.qds start",
    "stop": "bin/desktop.qds stop",
    "status": "bin/desktop.qds status",
    "theme": "bin/desktop.qds theme"
  },
  "cause-id": "界面.qd.图形图像桌面.qd",
  "parent_cause": "界面.qd"
}
