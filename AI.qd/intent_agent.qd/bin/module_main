LOG_DIR = os.path.join(AI_DIR, '日志')
TRACE_LOG = os.path.join(LOG_DIR, 'agent_trace.jsonl')
SHM_UI_AGENT = '/dev/shm/qd_ipc_ui_agent'
TEST_HOOK = os.path.join(SYSTEM_DIR, '功能.qd', '开发者.qd', 'test_hook.qds')
