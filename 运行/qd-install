#!/bin/bash
# ============================================================
# qd-install —— 奇点OS 安装后端（root 权限执行）
# 由应用中心 ui_installer.py 经 `sudo -n /usr/local/bin/qd-install` 调用；
# 通过 /etc/sudoers.d/qidos-installer 给 qduser 免密授权，
# 用户点一下"安装"就完事（Windows 式体验，无需输密码）。
# 用法：
#   qd-install repo   <包名>      从 Arch 仓库安装
#   qd-install search <关键词>    搜索仓库
#   qd-install local  <文件>      安装本地包（pkg.tar.*/AppImage/deb/tar.*）
#   qd-install remove <包名>      卸载
#   qd-install check  <命令名>    检查某命令是否已存在
# ============================================================
LOG=/tmp/qd_install.log
echo "=== $(date '+%F %T') $* ===" >> "$LOG"

case "$1" in
  repo)
    exec 2>&1
    pacman -S --noconfirm --needed "$2" | tee -a "$LOG"
    ;;
  search)
    pacman -Ss "$2" 2>/dev/null | head -60
    ;;
  local)
    f="$2"
    case "$f" in
      *.pkg.tar.zst|*.pkg.tar.xz|*.pkg.tar.gz)
        pacman -U --noconfirm "$f" | tee -a "$LOG"
        ;;
      *.AppImage)
        base=$(basename "$f")
        install -Dm755 "$f" "/opt/appimages/$base" && echo "OK:/opt/appimages/$base"
        ;;
      *.deb)
        name=$(basename "$f" .deb)
        mkdir -p "/opt/deb/$name"
        if command -v dpkg-deb >/dev/null 2>&1; then
          dpkg-deb -x "$f" "/opt/deb/$name" && echo "OK:/opt/deb/$name"
        else
          pacman -S --noconfirm --needed dpkg >/dev/null 2>&1
          dpkg-deb -x "$f" "/opt/deb/$name" && echo "OK:/opt/deb/$name" \
            || echo "ERR:解包失败，请先安装 dpkg"
        fi
        ;;
      *.tar.gz|*.tar.xz|*.tar.bz2|*.tgz)
        name=$(basename "$f"); name=${name%%.*}
        mkdir -p "/opt/tar/$name"
        tar -xf "$f" -C "/opt/tar/$name" --strip-components=1 && echo "OK:/opt/tar/$name"
        ;;
      *)
        echo "ERR:不支持的格式：$f"
        echo "提示：支持 pkg.tar.zst / AppImage / deb / tar.gz"
        ;;
    esac
    ;;
  remove)
    pacman -Rs --noconfirm "$2" | tee -a "$LOG"
    ;;
  check)
    command -v "$2" >/dev/null 2>&1 && echo "YES" || echo "NO"
    ;;
esac
