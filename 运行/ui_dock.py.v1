#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""奇点OS 底部 Dock（Mac 式快捷启动栏）"""
import gi, subprocess
gi.require_version('Gtk', '3.0')
from gi.repository import Gtk, Gdk, GLib

CSS = b"""
.dock { background-color: rgba(24, 27, 40, 0.92); border: 1px solid rgba(80, 92, 130, 0.55);
        border-radius: 24px; }
.dock-btn { background: transparent; border: none; border-radius: 14px; padding: 4px; }
.dock-btn:hover { background: rgba(120, 150, 210, 0.18); }
.dock-ico { color: #e8eaf0; font-size: 22px; }
.dock-lbl { color: #e8eaf0; font-size: 11px; }
"""

# 应用清单: (名称, 图标符号, 启动命令)
APPS = [
    ('文件管理', '📁', 'thunar'),
    ('奇点OS浏览', '🗂', 'python3 /奇点OS/运行/qd_fm.py'),
    ('浏览器', '🌐', 'qutebrowser'),
    ('终端', '⌨', 'xfce4-terminal'),
    ('设置', '⚙', 'xfce4-settings-manager'),
    ('AI意图', '🤖', 'python3 /奇点OS/运行/ai_agent.py'),
]

class Dock(Gtk.Window):
    def __init__(self, sw, sh):
        Gtk.Window.__init__(self, type=Gtk.WindowType.POPUP)
        self.set_decorated(False)
        self.set_keep_above(True)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_type_hint(Gdk.WindowTypeHint.DOCK)
        self.set_app_paintable(True)
        screen = self.get_screen()
        visual = screen.get_rgba_visual()
        if visual:
            self.set_visual(visual)

        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        box.get_style_context().add_class('dock')
        box.set_margin_left(16)
        box.set_margin_right(16)
        box.set_margin_top(8)
        box.set_margin_bottom(8)
        self.add(box)

        for name, ico, cmd in APPS:
            v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            b = Gtk.Button()
            b.get_style_context().add_class('dock-btn')
            b.set_relief(Gtk.ReliefStyle.NONE)
            b.set_size_request(58, 52)
            lbl = Gtk.Label(label=ico)
            lbl.get_style_context().add_class('dock-ico')
            b.add(lbl)
            b.connect('clicked', self._launch, cmd)
            v.pack_start(b, True, True, 0)
            t = Gtk.Label(label=name)
            t.get_style_context().add_class('dock-lbl')
            v.pack_start(t, False, False, 0)
            box.pack_start(v, False, False, 0)

        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        W = 58 * len(APPS) + 16 * 2 + 6 * (len(APPS) - 1) + 40
        H = 78
        self.set_default_size(W, H)
        self.move((sw - W) // 2, sh - H - 8)
        self.show_all()

    def _launch(self, btn, cmd):
        env = {
            'DISPLAY': ':0',
            'XAUTHORITY': '/home/qduser/.Xauthority',
            'XDG_RUNTIME_DIR': '/run/user/1000',
            'DBUS_SESSION_BUS_ADDRESS': 'unix:path=/run/user/1000/bus',
        }
        try:
            subprocess.Popen(cmd.split(), stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, env=env)
        except Exception as e:
            print('启动失败:', e)

if __name__ == '__main__':
    screen = Gdk.Screen.get_default()
    sw, sh = screen.get_width(), screen.get_height()
    win = Dock(sw, sh)
    win.connect('destroy', Gtk.main_quit)
    Gtk.main()
