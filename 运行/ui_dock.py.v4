#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
奇点OS 底部 Dock —— 替换版
- 完整应用标签（桌面全套图标 + 系统应用），分页显示 ◀ ▶
- 按住 Dock 空白处可拖动到屏幕任意位置（位置持久化）
- 右键添加应用（扫描系统 .desktop）、右键应用可移除
- 启动统一 sudo -u qduser（修复 root 启动 DBUS/Xfconf 失败）
"""
import gi, os, sys, json, subprocess, glob
gi.require_version('Gtk', '3.0')
from gi.repository import Gtk, Gdk, GLib, Pango

CONF_DIR = '/home/qduser/.config/qidos'
CONF = os.path.join(CONF_DIR, 'dock.json')
USER = 'qduser'
ENV_BASE = {
    'DISPLAY': ':0',
    'XAUTHORITY': '/home/qduser/.Xauthority',
    'XDG_RUNTIME_DIR': '/run/user/1000',
    'DBUS_SESSION_BUS_ADDRESS': 'unix:path=/run/user/1000/bus',
}

CSS = b"""
.dock { background-color: rgba(22, 25, 38, 0.94); border: 1px solid rgba(90, 104, 145, 0.6);
        border-radius: 26px; box-shadow: 0 8px 28px rgba(0,0,0,0.45); }
.dock-ico { color: #e8eaf0; font-size: 21px; }
.dock-lbl { color: #c7cedd; font-size: 10px; font-weight: 600; }
.dock-btn { background: transparent; border: none; border-radius: 16px; padding: 4px; }
.dock-btn:hover { background: rgba(120, 150, 210, 0.22); }
.dock-nav { background: rgba(120, 140, 190, 0.14); border: none; border-radius: 12px;
            color: #9fb0d0; font-size: 15px; font-weight: 700; padding: 0; }
.dock-nav:hover { background: rgba(140, 165, 220, 0.32); color: #e8eaf0; }
.dock-page { color: #7c8aa8; font-size: 10px; }
"""

# 默认应用清单: (名称, 图标, 启动命令)
DEFAULT_APPS = [
    ('文件管理',   '📁', 'thunar'),
    ('主文件夹',   '🏠', 'thunar /home/qduser'),
    ('文件系统',   '💽', 'thunar /'),
    ('奇点OS浏览', '🗂', 'python3 /奇点OS/运行/qd_fm.py'),
    ('奇点OS文件系统', '🖥', 'thunar /奇点OS/'),
    ('系统',       '⚙️', 'thunar /奇点OS/系统/'),
    ('用户.qd',    '👤', 'thunar /奇点OS/用户.qd/'),
    ('AI.qd',      '🤖', 'thunar /奇点OS/AI.qd/'),
    ('意图 INTENT','🧠', '/usr/bin/python3 /奇点OS/AI.qd/intent_agent.qd/share/intent_gui.py'),
    ('奇点OS状态', '📊', 'python3 /奇点OS/运行/status_panel.py'),
    ('浏览器',     '🌐', 'qutebrowser'),
    ('终端',       '⌨️', 'xfce4-terminal'),
    ('设置',       '🛠', 'xfce4-settings-manager'),
]

PAGE_SIZE = 6


def load_conf():
    try:
        with open(CONF, 'r', encoding='utf-8') as f:
            return json.load(f)
    except Exception:
        return {}


def save_conf(cfg):
    try:
        os.makedirs(CONF_DIR, exist_ok=True)
        with open(CONF, 'w', encoding='utf-8') as f:
            json.dump(cfg, f, ensure_ascii=False, indent=1)
        os.chmod(CONF_DIR, 0o755)
        os.chmod(CONF, 0o644)
    except Exception as e:
        print('保存配置失败:', e)


def launch(cmd):
    """以 qduser 身份 + 会话环境启动"""
    parts = cmd.split()
    argv = ['sudo', '-u', USER, 'env'] + \
        [f'{k}={v}' for k, v in ENV_BASE.items()] + parts
    try:
        subprocess.Popen(argv, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
        return True
    except Exception as e:
        print('启动失败:', e)
        return False


def scan_apps():
    """扫描系统 + 桌面 + 奇点OS 的 .desktop，返回 [(名称, 命令, 图标)]"""
    found, seen = [], set()
    for d in ['/usr/share/applications', '/home/qduser/.local/share/applications',
              '/home/qduser/Desktop']:
        for f in sorted(glob.glob(os.path.join(d, '*.desktop'))):
            name, exec_, icon = None, None, None
            try:
                with open(f, 'r', encoding='utf-8') as fp:
                    for line in fp:
                        line = line.strip()
                        if line.startswith('Name=') and name is None:
                            name = line[5:]
                        elif line.startswith('Name[zh_CN]='):
                            name = line[11:]
                        elif line.startswith('Exec='):
                            exec_ = line[5:]
                        elif line.startswith('Icon='):
                            icon = line[5:]
            except Exception:
                continue
            if name and exec_ and exec_ not in seen:
                seen.add(exec_)
                found.append((name, exec_, icon or 'application-x-executable'))
    return found


class AddAppDialog(Gtk.Dialog):
    def __init__(self, parent):
        super().__init__('添加应用到 Dock', parent, 0,
                         (Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL,
                          Gtk.STOCK_ADD, Gtk.ResponseType.OK))
        self.set_default_size(460, 420)
        box = self.get_content_area()
        self.search = Gtk.SearchEntry()
        self.search.set_placeholder_text('搜索应用…')
        box.pack_start(self.search, False, False, 4)
        sw = Gtk.ScrolledWindow()
        sw.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        self.listbox = Gtk.ListBox()
        self.listbox.set_selection_mode(Gtk.SelectionMode.SINGLE)
        sw.add(self.listbox)
        box.pack_start(sw, True, True, 0)
        self.apps = scan_apps()
        self._fill('')
        self.search.connect('search-changed', self._on_search)
        self.show_all()

    def _fill(self, kw):
        for child in self.listbox.get_children():
            self.listbox.remove(child)
        kw = kw.lower()
        for name, cmd, icon in self.apps:
            if kw and kw not in name.lower() and kw not in cmd.lower():
                continue
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            row.set_margin_start(10); row.set_margin_end(10); row.set_margin_top(4); row.set_margin_bottom(4)
            lbl = Gtk.Label(label=name, xalign=0)
            lbl.set_ellipsize(Pango.EllipsizeMode.END)
            cmd_l = Gtk.Label(label=cmd, xalign=1)
            cmd_l.set_opacity(0.6)
            cmd_l.set_ellipsize(Pango.EllipsizeMode.END)
            cmd_l.set_max_width_chars(30)
            row.pack_start(lbl, True, True, 0)
            row.pack_start(cmd_l, False, False, 0)
            row.cmd = cmd
            self.listbox.add(row)
        self.listbox.show_all()

    def _on_search(self, entry):
        self._fill(entry.get_text().strip())

    def selected(self):
        row = self.listbox.get_selected_row()
        if row:
            return getattr(row, 'cmd', None)
        return None


class Dock(Gtk.Window):
    def __init__(self):
        Gtk.Window.__init__(self, type=Gtk.WindowType.POPUP)
        self.set_decorated(False)
        self.set_keep_above(True)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_type_hint(Gdk.WindowTypeHint.DOCK)
        self.set_app_paintable(True)
        self.set_accept_focus(False)
        screen = self.get_screen()
        visual = screen.get_rgba_visual()
        if visual:
            self.set_visual(visual)

        self.cfg = load_conf()
        self.apps = self.cfg.get('apps') or DEFAULT_APPS
        self.page = 0
        self.connect('scroll-event', self._on_scroll)
        self._build()

        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        sw, sh = screen.get_width(), screen.get_height()
        W, H = 620, 84
        pos = self.cfg.get('pos')
        if pos:
            x, y = int(pos[0]), int(pos[1])
        else:
            x, y = (sw - W) // 2, sh - H - 10
        self._W, self._H = W, H
        self.set_default_size(W, H)
        self.move(x, y)
        self.show_all()

    def _build(self):
        if hasattr(self, 'outer'):
            self.remove(self.outer)
        self.outer = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=2)
        self.outer.get_style_context().add_class('dock')
        self.outer.set_margin_left(14); self.outer.set_margin_right(14)
        self.outer.set_margin_top(8); self.outer.set_margin_bottom(8)
        self.outer.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK
                              | Gdk.EventMask.SCROLL_MASK | Gdk.EventMask.SMOOTH_SCROLL_MASK)
        self.outer.connect('button-press-event', self._on_drag_start)
        self.outer.connect('button-release-event', self._on_drag_end)
        self.outer.connect('scroll-event', self._on_scroll)
        self.add(self.outer)

        # 左翻页
        self.prev_btn = Gtk.Button(label='◀')
        self.prev_btn.get_style_context().add_class('dock-nav')
        self.prev_btn.set_size_request(34, 56)
        self.prev_btn.connect('clicked', self._prev_page)
        self.outer.pack_start(self.prev_btn, False, False, 4)

        total = len(self.apps)
        pages = max(1, (total + PAGE_SIZE - 1) // PAGE_SIZE)
        self.page = min(self.page, pages - 1)
        start = self.page * PAGE_SIZE
        for name, ico, cmd in self.apps[start:start + PAGE_SIZE]:
            self._add_app_button(name, ico, cmd)
        # 补空位保持宽度稳定
        for _ in range(min(PAGE_SIZE, total) - min(PAGE_SIZE, total - start)):
            pass
        # 右翻页
        self.next_btn = Gtk.Button(label='▶')
        self.next_btn.get_style_context().add_class('dock-nav')
        self.next_btn.set_size_request(34, 56)
        self.next_btn.connect('clicked', self._next_page)
        self.outer.pack_start(self.next_btn, False, False, 4)

        # 页标 + 抓手
        tail = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.page_lbl = Gtk.Label(label=f'{self.page + 1}/{pages}')
        self.page_lbl.get_style_context().add_class('dock-page')
        grip = Gtk.Label(label='⠿')
        grip.get_style_context().add_class('dock-page')
        grip.set_opacity(0.8)
        tail.pack_start(self.page_lbl, True, True, 0)
        tail.pack_start(grip, True, True, 0)
        self.outer.pack_start(tail, False, False, 6)

        self._refresh_nav(pages)
        self.outer.show_all()

    def _add_app_button(self, name, ico, cmd):
        v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        b = Gtk.Button()
        b.get_style_context().add_class('dock-btn')
        b.set_relief(Gtk.ReliefStyle.NONE)
        b.set_size_request(62, 50)
        b.set_tooltip_text(name)
        lbl = Gtk.Label(label=ico)
        lbl.get_style_context().add_class('dock-ico')
        b.add(lbl)
        b.connect('clicked', self._launch, cmd)
        b.connect('button-press-event', self._on_app_press, cmd)
        v.pack_start(b, True, True, 0)
        t = Gtk.Label(label=name)
        t.get_style_context().add_class('dock-lbl')
        t.set_size_request(68, -1)
        t.set_ellipsize(Pango.EllipsizeMode.END)
        v.pack_start(t, False, False, 0)
        self.outer.pack_start(v, False, False, 0)
        v.cmd = cmd

    # ---- 分页 ----
    def _pages(self):
        return max(1, (len(self.apps) + PAGE_SIZE - 1) // PAGE_SIZE)

    def _refresh_nav(self, pages):
        self.prev_btn.set_sensitive(self.page > 0)
        self.next_btn.set_sensitive(self.page < pages - 1)
        self.page_lbl.set_text(f'{self.page + 1}/{pages}')

    def _prev_page(self, btn):
        if self.page > 0:
            self.page -= 1
            self._rebuild()

    def _next_page(self, btn):
        if self.page < self._pages() - 1:
            self.page += 1
            self._rebuild()

    def _rebuild(self):
        x, y = self.get_position()
        self._build()
        self.move(x, y)

    # ---- 滚轮翻页 ----
    def _on_scroll(self, box, event):
        if event.direction == Gdk.ScrollDirection.UP:
            if self.page > 0:
                self.page -= 1
                self._rebuild()
        elif event.direction == Gdk.ScrollDirection.DOWN:
            if self.page < self._pages() - 1:
                self.page += 1
                self._rebuild()
        return True

    # ---- 启动 ----
    def _launch(self, btn, cmd):
        launch(cmd)

    # ---- 右键菜单 ----
    def _on_app_press(self, btn, event, cmd):
        if event.button == 3:
            menu = Gtk.Menu()
            it = Gtk.MenuItem(label='从 Dock 移除')
            it.connect('activate', self._remove_app, cmd)
            menu.append(it)
            menu.show_all()
            menu.popup_at_pointer(event)
            return True
        return False

    def _remove_app(self, item, cmd):
        self.apps = [a for a in self.apps if a[2] != cmd]
        self.cfg['apps'] = self.apps
        save_conf(self.cfg)
        self.page = min(self.page, self._pages() - 1)
        self._rebuild()

    # ---- 添加 ----
    def _add_app(self):
        dlg = AddAppDialog(self)
        resp = dlg.run()
        cmd = dlg.selected()
        dlg.destroy()
        if resp == Gtk.ResponseType.OK and cmd:
            # 找到名称
            for name, c, icon in scan_apps():
                if c == cmd:
                    self.apps.append((name, '📌', cmd))
                    break
            self.cfg['apps'] = self.apps
            save_conf(self.cfg)
            self.page = self._pages() - 1
            self._rebuild()

    # ---- 拖动整体 ----
    def _on_drag_start(self, box, event):
        if event.button == 1:
            self.begin_move_drag(event.button, int(event.x_root), int(event.y_root), event.time)
            return True
        if event.button == 3:
            menu = Gtk.Menu()
            it = Gtk.MenuItem(label='添加应用…')
            it.connect('activate', lambda w: self._add_app())
            menu.append(it)
            menu.show_all()
            menu.popup_at_pointer(event)
            return True
        return False

    def _on_drag_end(self, box, event):
        if event.button == 1:
            self.cfg['pos'] = list(self.get_position())
            save_conf(self.cfg)
        return False


if __name__ == '__main__':
    screen = Gdk.Screen.get_default()
    win = Dock()
    win.connect('destroy', Gtk.main_quit)
    Gtk.main()
